# PostgreSQL connection string (required for accounts and admin API)
DATABASE_URL=postgresql://smile_user:change_me@localhost:5432/smile
# Set true only when your PostgreSQL provider requires verified TLS
PGSSL=false
PORT=3000
# Optional: configure these only when the owner chooses the administrator credentials.
# Never commit a real .env file or share the password in chat.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrateur SMILE

# Paiements Mobile Money activés : les membres peuvent soumettre des demandes TMoney/Flooz.
# Traitement 100 % manuel : chaque dépôt et retrait exige une validation administrative.
# Aucun transfert automatique ni appel API de paiement.
MOBILE_MONEY_ENABLED=true


# Rubrique Contrôle SMILE — définir ces secrets dans les variables privées du serveur.
# Ne jamais publier le fichier .env réel ni committer ces valeurs.
CONTROL_ACCESS_PASSWORD=
SPECIAL_ACCOUNT_1_PASSWORD=
SPECIAL_ACCOUNT_2_PASSWORD=
